# Kladee Broker — clean URLs (no .html in browser address bar)
# Works at domain root (Plesk) and subdirectory (XAMPP /kladeebroker/)
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Backend maintenance (production domain only — localhost /kladeebroker/ unaffected)
  # Toggle: remove file .maintenance in site root to reopen portal
  RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
  RewriteCond %{HTTP_HOST} ^(www\.)?kladeebroker\.co\.th$ [NC]
  RewriteCond %{REQUEST_URI} !^/kladeebroker/ [NC]
  RewriteCond %{REQUEST_URI} ^/(login|reset-password|admin|agent)(/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/maintenance$ [NC]
  RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
  RewriteCond %{REQUEST_URI} !^/css/maintenance\.css$ [NC]
  RewriteCond %{REQUEST_URI} !^/images/ [NC]
  RewriteCond %{REQUEST_URI} !^/favicon [NC]
  RewriteRule ^ maintenance [R=503,L]

  # Keep API and static tooling untouched
  RewriteRule ^(api|node_modules)/ - [L]

  # Slip files are served only via authenticated PHP, never as public static files
  RewriteRule ^uploads/ - [F,L]

  # Do not rewrite these .html assets (fetched by JS / templates)
  RewriteRule ^(partials|assets|totalmenu)/ - [L]

  # /path/index.html → /path/  (relative — keeps /kladeebroker prefix)
  RewriteCond %{THE_REQUEST} \s/+(?:.+?/)?index\.html[\s?] [NC]
  RewriteRule ^(.*?)index\.html$ $1 [R=301,L,NE]

  # /path/file.html → /path/file
  RewriteCond %{THE_REQUEST} \s/+(?:.+?/)?[^?\s]*?\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ $1 [R=301,L,NE]

  # Extensionless → serve matching .html when it exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
